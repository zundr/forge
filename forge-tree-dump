}

/**
 * Main entry point
 */
function main(argv) {
  // In GJS, ARGV doesn't include the script name, so use it directly
  let args = argv;

  // Parse arguments
  const options = parseArgs(args);

  // Show help if requested
  if (options.help) {
    print(HELP_TEXT);
    return 0;
  }

  // Get tree from extension
  let tree = getTreeFromExtension();

  if (!tree) {
    printerr("Warning: Forge extension is not running or D-Bus interface not available.");
    printerr("Using mock tree for demonstration purposes.\n");
    tree = getMockTree();
  }

  // Format and print tree
  const output = formatTree(tree, options);
  print(output);

  return 0;
}

// Run main function
const exitCode = main(ARGV);
System.exit(exitCode);
